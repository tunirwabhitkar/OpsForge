<!DOCTYPE html>
<html>
  <head>
    <title>OpsForge</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased">
    <% if user_signed_in? %>
      <div class="min-h-screen flex">
        <!-- Sidebar -->
        <aside class="w-64 bg-slate-900 text-slate-300 flex flex-col">
          <div class="p-6 text-xl font-bold text-white tracking-wider">OpsForge</div>
          <nav class="flex-1 px-4 space-y-1">
            <%= link_to "Overview", root_path, class: "block px-3 py-2 rounded-md hover:bg-slate-800 text-sm font-medium" %>
            <%= link_to "CRM Companies", crm_companies_path, class: "block px-3 py-2 rounded-md hover:bg-slate-800 text-sm font-medium" %>
            <%= link_to "CRM Deals", crm_deals_path, class: "block px-3 py-2 rounded-md hover:bg-slate-800 text-sm font-medium" %>
            <%= link_to "Recruitment Jobs", ats_jobs_path, class: "block px-3 py-2 rounded-md hover:bg-slate-800 text-sm font-medium" %>
            <%= link_to "Knowledge Base", kb_articles_path, class: "block px-3 py-2 rounded-md hover:bg-slate-800 text-sm font-medium" %>
            <%= link_to "Support Tickets", support_tickets_path, class: "block px-3 py-2 rounded-md hover:bg-slate-800 text-sm font-medium" %>
            <%= link_to "Integrations", integrations_path, class: "block px-3 py-2 rounded-md hover:bg-slate-800 text-sm font-medium" %>
          </nav>
          <div class="p-4 border-t border-slate-800 text-xs">
            <div class="font-semibold text-white"><%= current_user.name %></div>
            <div class="text-slate-400 truncate"><%= current_organization&.name %></div>
            <%= button_to "Sign out", session_path, method: :delete, class: "mt-3 w-full text-left text-red-400 hover:text-red-300 font-medium" %>
          </div>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col">
          <header class="bg-white shadow-sm h-16 flex items-center justify-between px-8">
            <div class="w-1/3">
              <%= form_with url: search_path, method: :get, local: true do |f| %>
                <%= f.text_field :q, placeholder: "Search OpsForge...", value: params[:q], class: "w-full px-3 py-1.5 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
              <% end %>
            </div>
            <div class="text-sm font-medium text-gray-600">
              <%= current_organization&.name %>
            </div>
          </header>
          <main class="flex-1 p-8">
            <% if notice.present? %>
              <div class="mb-4 p-4 bg-green-50 border border-green-200 text-green-700 rounded-md text-sm"><%= notice %></div>
            <% end %>
            <% if alert.present? %>
              <div class="mb-4 p-4 bg-red-50 border border-red-200 text-red-700 rounded-md text-sm"><%= alert %></div>
            <% end %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <div class="min-h-screen flex items-center justify-center bg-gray-100">
        <div class="max-w-md w-full bg-white p-8 rounded-lg shadow-md">
          <%= yield %>
        </div>
      </div>
    <% endif %>
  </body>
</html>
