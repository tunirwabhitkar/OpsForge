<h2 class="text-2xl font-bold text-center text-gray-900 mb-6">Create your OpsForge Account</h2>

<%= form_with model: @user, url: registrations_path, local: true, class: "space-y-4" do |f| %>
  <% if @user.errors.any? %>
    <div class="p-3 bg-red-50 text-red-700 text-sm rounded-md">
      <ul class="list-disc pl-4 space-y-1">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :first_name, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :first_name, required: true, class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-md text-sm" %>
    </div>
    <div>
      <%= f.label :last_name, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :last_name, required: true, class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-md text-sm" %>
    </div>
  </div>
  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
    <%= f.email_field :email, required: true, class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-md text-sm" %>
  </div>
  <div>
    <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
    <%= f.password_field :password, required: true, class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-md text-sm" %>
  </div>
  <div>
    <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700" %>
    <%= f.password_field :password_confirmation, required: true, class: "mt-1 w-full px-3 py-2 border border-gray-300 rounded-md text-sm" %>
  </div>
  <div>
    <%= f.submit "Create Account", class: "w-full py-2 px-4 bg-indigo-600 text-white font-medium rounded-md hover:bg-indigo-700 text-sm" %>
  </div>
<% end %>

<div class="mt-4 text-center text-sm text-gray-600">
  Already have an account? <%= link_to "Sign in", new_session_path, class: "text-indigo-600 hover:underline font-medium" %>
</div>
